{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/thejjeanjjorge/motion-for-agents/blob/main/schemas/motion-plan.schema.json",
  "title": "Motion for Agents plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "preset",
    "reducedMotion",
    "transitions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "preset": {
      "enum": [
        "quiet",
        "spring",
        "celebration"
      ]
    },
    "reducedMotion": {
      "enum": [
        "user",
        "always"
      ]
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "intent",
          "target",
          "trigger",
          "component"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "reveal",
              "navigate",
              "feedback",
              "press",
              "progress",
              "celebrate"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "enum": [
              "MotionReveal",
              "MotionSwitch",
              "MotionFeedback",
              "MotionButton",
              "MotionProgress",
              "MotionCelebration"
            ]
          },
          "preset": {
            "description": "Optional override of the plan preset for this transition's component.",
            "enum": [
              "quiet",
              "spring",
              "celebration"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "reveal"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionReveal"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "navigate"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionSwitch"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "feedback"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionFeedback"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "press"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionButton"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "progress"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionProgress"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "celebrate"
                }
              },
              "required": [
                "intent"
              ]
            },
            "then": {
              "properties": {
                "component": {
                  "const": "MotionCelebration"
                },
                "preset": false
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
